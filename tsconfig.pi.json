{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "claude-code": ["types/claude-code.d.ts"]
    }
  },
  "include": ["pi", "types/pi-coding-agent.d.ts", "tests/pi.test.ts"]
}
